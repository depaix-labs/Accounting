#!/bin/zsh
set -euo pipefail

mode=${1:-}

case "$mode" in
    all)
        (
            sbm || return 1;
            swift run --package-path Tests t_accounting && swift run --package-path Tests t_accounting_full;
            swift run ec_v2 period;
            swift run ec_v2 compile --closing --carryforward --by-entity --trace;
            cd Tests/Fixtures/accounting-example && ec;
        )
        ;;
    long)
        (
            swift run --package-path Tests t_accounting_full;
        )
        ;;
    check)
        (
            sbm || return 1;
            swift run --package-path Tests t_accounting;
            cd Tests/Fixtures/accounting-example \
                && ec \
                && ec period year --anchor 2026-01-01 --by-entity;
        )
        ;;
    fast)
        (
            swift run --package-path Tests t_accounting;
        )
        ;;
    v2)
        (
            swift run ec_v2 period;
            swift run ec_v2 compile --closing --carryforward --by-entity --trace;
            swift run ec_v2 continuity;
            swift run ec_v2 windows --unit month --anchor 2026-10-15 --count 2;
            swift run ec_v2 windows --unit month --anchor 2026-10-15 --count 4;
            swift run ec_v2 positions --unit month --anchor 2026-10-15 --count 2;
            swift run ec_v2 positions --unit month --anchor 2026-10-15 --count 4;
            swift run ec_v2 bounded;
            swift run ec_v2 comparative;
        )
        ;;
    ec)
        (
            cd Tests/Fixtures/accounting-example && ec;
        )
        ;;
    *)
        echo "usage: ./test <all|long|check|fast|v2|ec>" >&2
        exit 1
        ;;
esac

